@online{khanCognitiveETLUsing2025,
  type = {SSRN Scholarly Paper},
  title = {Cognitive {{ETL}}: {{Using AI}} to {{Interpret Complex Data Relationships}}},
  shorttitle = {Cognitive {{ETL}}},
  author = {Khan, Jahangir},
  date = {2025-11-10},
  number = {5728984},
  eprint = {5728984},
  eprinttype = {Social Science Research Network},
  location = {Rochester, NY},
  doi = {10.2139/ssrn.5728984},
  url = {https://papers.ssrn.com/abstract=5728984},
  urldate = {2026-05-08},
  abstract = {Traditional Extract, Transform, and Load (ETL) processes are primarily rule-based and limited in their ability to adapt to the growing complexity of modern data ecosystems. As data sources diversify across structured, semi-structured, and unstructured formats, conventional ETL pipelines struggle to capture the nuanced relationships and contextual meaning inherent in enterprise data. This paper introduces Cognitive ETL, an AI-driven framework that integrates machine learning, natural language processing, and knowledge graph technologies to enhance the semantic understanding and automation of data transformation workflows. By leveraging AI to interpret data relationships, Cognitive ETL dynamically maps disparate datasets, infers missing links, and optimizes transformation logic based on learned patterns. The approach aims to reduce manual intervention, improve data quality, and enable context-aware analytics in real time. Experimental results demonstrate that Cognitive ETL can outperform traditional ETL systems in both adaptability and interpretability, offering a foundation for the next generation of intelligent data integration platforms.},
  langid = {english},
  pubstate = {prepublished},
  keywords = {Artificial Intelligence,Automation,Cognitive ETL,Data Integration,Data Relationship Inference,Data Transformation,Intelligent Data Processing,Knowledge Graphs,Machine Learning,Semantic Modeling},
  file = {C:\Users\geige\Zotero\storage\KGNX8ZVU\Khan - 2025 - Cognitive ETL Using AI to Interpret Complex Data Relationships.pdf}
}

@online{khanIntelligentAnomalyDetection2025,
  type = {SSRN Scholarly Paper},
  title = {Intelligent {{Anomaly Detection}} in {{ETL Workflows Using AI}}},
  author = {Khan, Jahangir},
  date = {2025-11-09},
  number = {5729002},
  eprint = {5729002},
  eprinttype = {Social Science Research Network},
  location = {Rochester, NY},
  doi = {10.2139/ssrn.5729002},
  url = {https://papers.ssrn.com/abstract=5729002},
  urldate = {2026-05-08},
  abstract = {The increasing volume, velocity, and variety of data in modern enterprise environments have intensified the complexity of Extract, Transform, Load (ETL) workflows, making them prone to anomalies that can disrupt downstream analytics and decision-making. Traditional monitoring techniques often rely on static rules or threshold-based alerts, which fail to detect subtle, evolving, or previously unseen anomalies. This study proposes an AI-driven framework for intelligent anomaly detection in ETL workflows, leveraging advanced machine learning models, including ensemble learning, recurrent neural networks (RNNs), and unsupervised clustering algorithms. The framework continuously monitors ETL pipeline metrics, such as data volume, transformation errors, latency, and schema deviations, to identify irregular patterns indicative of potential failures or performance degradation. Experimental evaluation on both synthetic and real-world enterprise datasets demonstrates the framework's capability to detect complex anomalies with high precision and recall, significantly reducing the time to mitigation and enhancing data reliability. The integration of explainable AI components further enables actionable insights for data engineers, facilitating rapid root-cause analysis and corrective interventions. The proposed approach represents a paradigm shift in ETL monitoring, transforming reactive troubleshooting into proactive anomaly management, thereby improving operational efficiency, data quality, and overall business intelligence outcomes.},
  langid = {english},
  pubstate = {prepublished},
  keywords = {AI-Driven Monitoring,Data Pipeline Reliability,Data Quality Assurance,ETL Workflows,Explainable AI,Intelligent Anomaly Detection,Machine Learning,Predictive Analytics,Recurrent Neural Networks,Unsupervised Clustering},
  file = {C:\Users\geige\Zotero\storage\9K37RY3S\Khan - 2025 - Intelligent Anomaly Detection in ETL Workflows Using AI.pdf}
}


