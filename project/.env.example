# Kopiere diese Datei zu `.env` und trage deine Keys ein.
# `.env` ist in .gitignore - niemals committen!

ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=...

# Optional: lokales Modell via Ollama (Standard-Port)
OLLAMA_HOST=http://localhost:11434

# Globaler Seed für Daten-Generierung (Reproduzierbarkeit)
RANDOM_SEED=42
